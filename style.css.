/* Container for each menu item */
.menu-item {
  background-color: #f9f9f9;
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  padding: 12px 16px;
  margin-bottom: 12px;
}

/* Style the dish title */
.menu-item h3 {
  margin: 0 0 4px 0;
  color: #222222;
}

/* Style the price tag */
.menu-item p {
  margin: 0;
  color: #2e7d32; /* Clean green color for currency */
  font-weight: bold;
}
/* Styling the search box */
#searchInput {
  width: 100%;
  padding: 10px;
  font-size: 16px;
  border: 1px solid #ccc;
  border-radius: 6px;
  box-sizing: border-box;
  margin-bottom: 10px;
}

/* Button layout container */
.filter-buttons {
  display: flex;
  gap: 8px;
  margin-bottom: 10px;
}

/* Category buttons */
.filter-buttons button {
  flex: 1;
  padding: 8px 12px;
  background-color: #f0f0f0;
  border: 1px solid #ccc;
  border-radius: 6px;
  font-weight: bold;
  cursor: pointer;
}

/* Highlight active buttons on tap */
.filter-buttons button:active {
  background-color: #2e7d32;
  color: white;
}
